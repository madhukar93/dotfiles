# Managed by chezmoi (dot_Brewfile.tmpl -> ~/.Brewfile).
# Curated to match what the rest of this dotfiles repo actually references —
# not a full dump of any one machine's install history. Run via:
#   brew bundle --file="$HOME/.Brewfile"
# (the run_onchange_after_10-brew-bundle.sh.tmpl script does this automatically
# on `chezmoi apply` whenever this file's rendered content changes).

# -- chezmoi itself -------------------------------------------------------------
# Keeps chezmoi on a native-arch, brew-managed build. A stale x86_64-only
# chezmoi binary elsewhere on PATH will cause every child process it spawns
# (e.g. this Brewfile's own bootstrap script) to inherit Rosetta translation,
# which then makes `brew install`/`upgrade` refuse to run.
brew "chezmoi"

# -- shells / prompt ----------------------------------------------------------
brew "fish"
brew "starship"
brew "direnv"

# -- core CLI tools -------------------------------------------------------------
brew "atuin" # cross-shell, cross-machine synced history — see run_once_after_40-atuin.sh.tmpl
brew "fzf"
brew "ripgrep"
brew "fd"
brew "bat"
brew "lsd"
brew "jq"
brew "tig"
brew "lazygit"
brew "nnn"
brew "mdcat"
brew "eget"
brew "gnupg"
brew "bitwarden-cli"

# -- editors / multiplexer ------------------------------------------------------
brew "neovim"
brew "tmux"

# -- kubernetes / cloud / infra ---------------------------------------------------
brew "kubernetes-cli" # provides kubectl
brew "kustomize"
brew "dyff"
brew "stern"
brew "krew"
brew "argocd"
brew "terraform"
brew "awscli"
brew "gh"

# -- language version managers ---------------------------------------------------
brew "pyenv"
brew "pyenv-virtualenv"
brew "rbenv"
# sdkman and oh-my-zsh have no Homebrew formula; installed by
# run_once_after_* scripts below instead.

# -- more CLI tools (added 2026-10-13 from what was installed on the old laptop) --
brew "dust"        # disk usage
brew "gitleaks"    # finds secrets in git history
brew "glances"
brew "glow"        # renders Markdown in the terminal
brew "goaccess"
brew "gum"
brew "htop"
brew "k9s"         # Kubernetes terminal viewer; config lives under Library/Application Support/k9s
brew "kubectx"
brew "mise"        # language version manager; statusLine in .claude/settings.json uses its node
brew "mtr"
brew "nmap"
brew "oasdiff"
brew "pgcli"
brew "pipx"
brew "poppler"
brew "pre-commit"
brew "procs"
brew "rtk"
brew "scc"
brew "shellcheck"
brew "tldr"
brew "tre-command"
brew "uv"
brew "yq"

{{ if eq .chezmoi.os "darwin" -}}
# -- macOS-only (casks) -----------------------------------------------------------
cask "gcloud-cli" # renamed from google-cloud-sdk
cask "karabiner-elements"
cask "tailscale-app" # renamed from tailscale
cask "orbstack"
cask "font-0xproto-nerd-font" # the one nerd font dot_wezterm.lua actually references
cask "alacritty"
cask "bitwarden"
cask "chatgpt"
cask "claude"
cask "claude-code@latest"
cask "cmux"
cask "codex"
cask "comet"
cask "firefox@developer-edition"
cask "headroom"
cask "homerow"
cask "jordanbaird-ice@beta"
cask "kde-connect"
cask "keepingyouawake"
cask "keyclu"
cask "notion"
cask "obsidian" # opens the journal in the personal-system repository
cask "pearcleaner"
cask "raycast"
cask "rectangle"
cask "slack"
tap "jbearak/table-viewer"
cask "jbearak/table-viewer/table-viewer"
cask "visual-studio-code"
cask "vscodium@insiders"
cask "zoom"
tap "daveshanley/vacuum"
cask "daveshanley/vacuum/vacuum" # OpenAPI linter
{{ else -}}
# -- Linux notes ------------------------------------------------------------------
# No Homebrew cask equivalents for: wezterm (build/install separately), Karabiner
# (macOS-only, not applicable), google-cloud-sdk (use the official apt/install
# script), tailscale (use your distro's package or the official install script).
# Nerd fonts: install font-0xproto-nerd-font manually or via your distro's font
# packages, since Homebrew casks aren't available on Linux.
{{ end -}}
