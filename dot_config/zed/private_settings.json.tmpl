// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "disable_ai": false,
  "context_servers": {
    "terraform-context-server": {
      "enabled": true,
      "settings": {}
    }
  },
{{ if .work -}}
  "agent": {
    "dock": "right",
    "default_model": {
      "provider": "amazon-bedrock",
      "model": "claude-opus-4-6-thinking",
      "enable_thinking": true
    },
    "favorite_models": [],
    "model_parameters": []
  },
  "ssh_connections": [
    {
      "host": "madhukar-pc-tailscale",
      "args": [],
      "projects": [
        {
          "paths": ["{{ .workProjectPath }}.code-workspace"]
        }
      ]
    },
    {
      "host": "madhukar-pc-sshd-via-tailscale",
      "args": [],
      "projects": [
        {
          "paths": ["/home/madhukar"]
        },
        {
          "paths": ["{{ .workProjectPath }}"]
        },
        {
          "paths": ["{{ .workProjectPath }}-infra"]
        }
      ]
    }
  ],
  "language_models": {
    "bedrock": {
      "authentication_method": "named_profile",
      "region": "{{ .workBedrockRegion }}",
      "profile": "{{ .workBedrockProfile }}"
    }
  },
{{ end -}}
{{ if .personal -}}
  "language_models": {
    "ollama": {
      "low_speed_timeout_in_seconds": 120,
      "available_models": [
        {
          "provider": "ollama",
          "name": "codestral:latest",
          "max_tokens": 32768
        }
      ]
    }
  },
{{ end -}}
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Tokyo Night"
  }
}
