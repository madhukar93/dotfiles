{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Keep large system folders on the /data disk, with a symlink at each usual path so
# every tool keeps finding them. A second Linux install that shares the disk (dual
# boot) links the same folders. Uses sudo, because these folders belong to root.
# Re-runs only when this script changes.
set -euo pipefail

if [ -L /data ] && [ ! -d /data/ ]; then
  echo "/data is not mounted; mount it and run 'chezmoi apply' again." >&2
  exit 1
fi
[ -d /data/ ] || exit 0

failed=0

# Copy, flush to disk, then delete, so a crash never leaves only an unwritten copy.
move() { sudo cp -a "$1" "$2" && sync && sudo rm -rf "$1"; }

# link <system folder> <folder on /data> [subfolders that hold a real install]
# With no subfolders the folder is a cache, and two copies are merged.
link() {
  local src=$1 data=$2
  shift 2
  if [ -L "$src" ]; then
    [ "$(readlink "$src")" = "$data" ] && return 0
    echo "skip  $src: links somewhere else ($(readlink "$src"))" >&2
    failed=1
    return 0
  fi
  if [ -e "$src" ] && [ -e "$data" ]; then
    if [ $# -eq 0 ]; then
      sudo cp -an "$src/." "$data/" && sync && sudo rm -rf "$src"
    elif [ -n "$(cd "$src" && find "$@" -mindepth 1 -maxdepth 1 2>/dev/null | head -n1)" ]; then
      echo "skip  $src: it and $data both hold an install; merge them by hand" >&2
      failed=1
      return 0
    else
      # A fresh install with nothing in it yet: keep it aside, use the shared one.
      sudo mv "$src" "$src.before-data"
    fi
  elif [ -e "$src" ]; then
    move "$src" "$data"
  else
    sudo mkdir -p "$data"
  fi
  sudo ln -s "$data" "$src"
  echo "link  $src -> $data"
}

# flatpak: everything on /data except exports, its 200 KB of menu entries. WSLg builds the
# Windows Start menu from /var/lib/flatpak/exports/share/applications, but looks for that
# folder only once, when WSL starts, which is before a Windows task attaches /data.
fp=/var/lib/flatpak
if [ "$(readlink "$fp")" = /data/flatpak ]; then
  # Earlier versions linked the whole folder.
  sudo rm "$fp"
  sudo mkdir "$fp"
  [ ! -e /data/flatpak/exports ] || move /data/flatpak/exports "$fp/exports"
fi
sudo mkdir -p "$fp"
link "$fp/app" /data/flatpak/app .
link "$fp/runtime" /data/flatpak/runtime .
link "$fp/repo" /data/flatpak/repo objects
link "$fp/appstream" /data/flatpak/appstream
link "$fp/.removed" /data/flatpak/.removed
link /var/cache/pacman/pkg /data/pacman-pkg

# At WSL start the menu entries point into the not yet attached disk, so WSLg drops them.
# Once the disk is mounted, re-create each one: WSLg watches the folder and reads new entries.
disk=$(systemd-escape -p --suffix=mount "$(findmnt -no TARGET --target /data/)")
printf '%s\n' "[Unit]
Description=Show flatpak apps in the Windows Start menu once the /data disk is attached
After=$disk

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'cd $fp/exports/share/applications && for f in *.desktop; do t=\$\$(readlink \"\$\$f\") && rm \"\$\$f\" && ln -s \"\$\$t\" \"\$\$f\"; done'

[Install]
WantedBy=$disk" | sudo tee /etc/systemd/system/flatpak-start-menu.service >/dev/null
sudo systemctl daemon-reload
sudo systemctl enable flatpak-start-menu.service

# WSLg does not read ~/.local/share/applications, where Gear Lever puts AppImage menu
# entries, but it does read /usr/local/share/applications.
user_apps="$HOME/.local/share/applications"
mkdir -p "$user_apps"
if [ ! -e /usr/local/share/applications ]; then
  sudo ln -s "$user_apps" /usr/local/share/applications
elif [ "$(readlink /usr/local/share/applications)" != "$user_apps" ]; then
  echo "skip  /usr/local/share/applications already exists" >&2
  failed=1
fi

exit $failed
{{ end -}}
