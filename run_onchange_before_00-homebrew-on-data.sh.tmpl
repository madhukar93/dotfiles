{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Keep Homebrew on the /data disk. Its ready-built packages only work at
# /home/linuxbrew/.linuxbrew, and brew resolves symlinks, so /data/linuxbrew is
# bind-mounted at that exact path instead. The mount is wanted by the /data disk's own
# mount unit, so it starts as soon as the disk is mounted: a Windows task attaches the
# disk some time after WSL starts. Sorts before 00-install-homebrew, so a second Linux install that shares
# the disk (dual boot) uses this Homebrew instead of installing another.
# Uses sudo. Re-runs only when this script changes.
set -euo pipefail

prefix=/home/linuxbrew/.linuxbrew
data=/data/linuxbrew
unit=home-linuxbrew-.linuxbrew # systemd-escape -p /home/linuxbrew/.linuxbrew

if [ -L /data ] && [ ! -d /data/ ]; then
  echo "/data is not mounted; mount it and run 'chezmoi apply' again." >&2
  exit 1
fi
[ -d /data/ ] || exit 0

real=$(readlink -f "$data")
# The disk's mount unit (mnt-wsl-data.mount on WSL). A path unit watching $real never
# fired: inotify does not report a filesystem being mounted over a folder.
disk=$(systemd-escape -p --suffix=mount "$(findmnt -no TARGET --target "$real")")

# No default dependencies: they make the mount part of local-fs.target, and the disk
# is only attached after boot.
mount_unit="[Unit]
Description=Homebrew from the /data disk
DefaultDependencies=no
BindsTo=$disk
After=$disk
Conflicts=umount.target
Before=umount.target

[Mount]
What=$real
Where=$prefix
Type=none
Options=bind

[Install]
WantedBy=$disk"

if mountpoint -q "$prefix" &&
  [ "$(cat "/etc/systemd/system/$unit.mount" 2>/dev/null)" = "$mount_unit" ] &&
  [ ! -e "/etc/systemd/system/$unit.path" ] &&
  systemctl is-enabled -q "$unit.mount"; then
  exit 0
fi

# Lists type, mode, size, link count, path and link target, so two trees can be compared.
# Folder sizes are left out: they depend on how the filesystem stored the entries.
tree() { (cd "$1" && sudo find . \( -type d -printf 'd %m %p\n' \) -o \( ! -type d -printf '%y %m %s %n %p %l\n' \) | sort); }

copied=0
if mountpoint -q "$prefix"; then
  :
elif [ -e "$prefix/bin/brew" ] && [ -e "$data" ]; then
  echo "homebrew: both $prefix and $data hold Homebrew; merge them by hand" >&2
  exit 1
elif [ -e "$prefix/bin/brew" ]; then
  sudo cp -a "$prefix" "$data"
  sync
  copied=1
elif [ ! -e "$data" ]; then
  # No Homebrew yet: the installer that runs next puts it straight onto /data.
  sudo mkdir -p "$data"
  sudo chown "${SUDO_USER:-$(id -un)}:" "$data"
fi
sudo mkdir -p "$prefix"

# Earlier versions of this script used a path unit instead.
if [ -e "/etc/systemd/system/$unit.path" ]; then
  sudo systemctl disable --now "$unit.path"
  sudo rm "/etc/systemd/system/$unit.path"
fi
printf '%s\n' "$mount_unit" | sudo tee "/etc/systemd/system/$unit.mount" >/dev/null
sudo systemctl daemon-reload
sudo systemctl enable --now "$unit.mount"
mountpoint -q "$prefix"
echo "mount $data at $prefix"

[ $copied -eq 1 ] || exit 0

# The original is now hidden under the mount. A second, non-recursive view of its
# parent shows it again; delete it only if it matches the copy exactly.
view=$(mktemp -d)
sudo mount --bind "${prefix%/*}" "$view"
if [ "$(tree "$view/${prefix##*/}")" = "$(tree "$prefix")" ]; then
  sudo find "$view/${prefix##*/}" -xdev -mindepth 1 -delete
  echo "removed the original under $prefix"
else
  echo "homebrew: the copy on $data differs from the original; the original is kept under the mount" >&2
fi
sudo umount "$view"
rmdir "$view"
{{ end -}}
